# Supabase / PostgreSQL connection string. Never commit .env.local.
DATABASE_URL=
# postgres (or supabase) for production / local Docker / CI.
DATABASE_DRIVER=
# Supabase API (for Supabase Auth / Client SDK / Browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical public origin behind a reverse proxy.
APP_ORIGIN=
LOG_LEVEL=
# Only for an isolated *_test database, never production.
E2E_TEST_MODE=
E2E_SEED_TOKEN=
