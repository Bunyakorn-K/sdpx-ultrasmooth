# Postgres connection string used by Drizzle (src/db/client.ts) and drizzle-kit.
# Local dev default matches compose.yaml's db service credentials.
DATABASE_URL=postgres://user:pass@localhost:5432/paireval
# Direct connection for migrations; managed hosts may also supply a pooled URL above.
DATABASE_URL_UNPOOLED=
# Branch-specific managed Better Auth URL (includes its path).
NEON_AUTH_BASE_URL=
# Generate at least 32 random characters and inject at runtime; never commit a value.
NEON_AUTH_COOKIE_SECRET=
# Comma-separated managed Auth subject IDs authorized to teach. New users are students.
TEACHER_AUTH_IDS=
# Explicit local/isolated-test escape hatch only. Always disabled in production.
ENABLE_DEV_AUTH=0
