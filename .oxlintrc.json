{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "import"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/purity": "off",
    "import/newline-after-import": "error"
  },
  "overrides": [
    {
      "files": ["tests/e2e/fixtures/**/*.ts"],
      "rules": {
        "no-empty-pattern": "off"
      }
    },
    {
      "files": ["scripts/**/*.mjs"],
      "rules": {
        "no-unsafe-finally": "off"
      }
    }
  ],
  "ignorePatterns": [
    ".next/**",
    ".next*/**",
    "coverage/**",
    "docs/coverage/**",
    "playwright-report/**",
    "test-results/**",
    "out/**",
    "build/**",
    "next-env.d.ts"
  ]
}
