    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "^3.2.2",
    "animejs": "^4.5.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "^2.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.0.15",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "27.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.0.15"
  },
  "ignoreScripts": [
