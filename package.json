{
  "name": "sdpx-ultrasmooth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "postcss": "^8.5.31",
    "source-map-js": "^1.2.2"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit && redocly lint docs/openapi.yaml",
    "lint:api": "redocly lint docs/openapi.yaml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:smoke": "bun run scripts/db-smoke.ts",
    "test:workflows": "bun run scripts/verify-workflows.ts",
    "test:auth:live": "bun run scripts/verify-managed-auth.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@heroui/styles": "^3.2.2",
    "@neon/config": "^1.9.2",
    "@neondatabase/auth": "^0.6.0-beta",
    "animejs": "^4.5.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@redocly/cli": "^2.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.1.12",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "27.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
